# Unison
.unison*
test-output
unisonLocal.zip
*.uc
# Ignore all scratch files...
*.u
# Except those in unison-src
!unison-src/**/*.u
# And integration tests
!unison-cli-integration/integration-tests/IntegrationTests/**/*.u

# Auto-generated
unison-src/builtin-tests/interpreter-tests.md

# Stack
*.stack-work*

# Cabal
dist-newstyle

# GHC
*.hie
*.prof
*.prof.html
*.hp
*.ps
*.profiterole.*
/.direnv/
/.envrc

# Mac developers
**/.DS_Store
/libb2.dylib

# Nix
result
result-transcripts

# Local verification proofs (see scripts/proofs/)
.local-proofs/

# Agent stuff
/.claude
*.local.md

# Outputs of the JIT transcripts, written next to them by transcript.fork and never committed
# (unison-runtime/src/Unison/Runtime/JIT/development.md); untracked, they would change the proof hashes
unison-src/transcripts-manual/jit-*.output.md
unison-src/transcripts/idempotent/jit-tests.output.md
